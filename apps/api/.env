APP_NAME="Kine API"
APP_ENV=local
APP_KEY=base64:nC6q73TVvn5FVeznzBSokH4mu18Tqcik1+8v9lwkBa8=
APP_DEBUG=true
APP_URL=http://localhost:8000

# --- Locales ---
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# --- Banco de Dados ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kine_db
DB_USERNAME=developer
DB_PASSWORD=developer_password

# --- Cache, Fila e Sessão ---
# Dica: Mude QUEUE_CONNECTION para 'redis' se quiser processar tarefas em background
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=redis

# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mail ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Broadcaster (Reverb) ---
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=831690
REVERB_APP_KEY=o2jluitg0qssfq3st1lk
REVERB_APP_SECRET=oplfvgoo2po2as2v7c7b

# Host para o PHP se conectar ao Reverb (Docker: reverb, local: localhost)
REVERB_BROADCAST_HOST=reverb

# Configurações do servidor Reverb dentro do Docker
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Configurações para o cliente (Frontend)
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Variáveis VITE para o React/Frontend
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
